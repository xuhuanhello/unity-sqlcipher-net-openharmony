# syntax=docker/dockerfile:1
FROM debian:12-slim

# Android NDK 版本
ARG NDK_VERSION=r22b

# 安装基础工具和构建依赖
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
        curl \
        unzip \
        build-essential \
        python3 \
        python3-pip \
        ninja-build \
        pkg-config \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 安装 Meson
RUN pip3 install --no-cache-dir --break-system-packages meson

# 下载并安装 Android NDK
RUN curl -SLO https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux-x86_64.zip \
    && unzip android-ndk-${NDK_VERSION}-linux-x86_64.zip \
    && mv ./android-ndk-${NDK_VERSION} /opt/ndk \
    && rm android-ndk-${NDK_VERSION}-linux-x86_64.zip

# 设置环境变量
ENV ANDROID_NDK_ROOT=/opt/ndk
ENV PATH="${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64/bin:${PATH}"

# 设置工作目录
WORKDIR /workspace

# 验证安装
RUN meson --version && ninja --version && ls -la ${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android*-clang || true
