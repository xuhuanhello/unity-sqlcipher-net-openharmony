# OpenHarmony 构建环境 Dockerfile
# 基于 Ubuntu 22.04，包含 OpenHarmony SDK 和构建工具

FROM ubuntu:22.04

# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive

# 安装基础依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    wget \
    curl \
    unzip \
    tar \
    git \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 安装 Meson
RUN pip3 install meson

# 下载并安装真实的OpenHarmony SDK
ENV OHOS_SDK_VERSION=5.1.0
ENV OHOS_SDK_URL=https://repo.huaweicloud.com/openharmony/os/5.1.0-Release/ohos-sdk-windows_linux-public.tar.gz

# 在临时目录下载和解压，避免路径冲突
RUN echo "下载 OpenHarmony SDK..." && \
    cd /tmp && \
    wget -q ${OHOS_SDK_URL} -O ohos-sdk.tar.gz && \
    echo "解压 OpenHarmony SDK..." && \
    tar -xzf ohos-sdk.tar.gz && \
    echo "检查SDK结构..." && \
    ls -la ohos-sdk/ && \
    ls -la ohos-sdk/linux/ && \
    echo "解压Linux平台的zip文件..." && \
    cd ohos-sdk/linux && \
    for zipfile in *.zip; do \
        if [[ -f "$zipfile" ]]; then \
            echo "解压 $zipfile..."; \
            unzip -q "$zipfile"; \
        fi; \
    done && \
    echo "检查解压后的Linux目录结构..." && \
    ls -la && \
    find . -name "native" -type d && \
    echo "移动SDK到最终位置..." && \
    cd /tmp && \
    mv ohos-sdk /opt/ && \
    rm -f ohos-sdk.tar.gz && \
    echo "验证最终SDK目录结构..." && \
    ls -la /opt/ohos-sdk/ && \
    ls -la /opt/ohos-sdk/linux/ && \
    echo "OpenHarmony SDK 安装完成"

# 查找并设置正确的 OpenHarmony 环境变量
RUN echo "查找OpenHarmony NDK路径..." && \
    echo "完整的SDK目录结构:" && \
    find /opt/ohos-sdk -type d | head -20 && \
    echo "查找native目录:" && \
    find /opt/ohos-sdk -name "native" -type d && \
    echo "查找llvm目录:" && \
    find /opt/ohos-sdk -name "llvm" -type d && \
    echo "查找clang文件:" && \
    find /opt/ohos-sdk -name "clang" -type f && \
    echo "设置环境变量..."

# 根据Linux SDK结构设置环境变量
# Linux SDK结构: /opt/ohos-sdk/linux/native/native/
ENV OHOS_NDK_ROOT=/opt/ohos-sdk/linux/native/native
ENV PATH=${OHOS_NDK_ROOT}/llvm/bin:${PATH}

# 验证 SDK 安装
RUN echo "验证 OpenHarmony SDK 安装..." && \
    echo "检查NDK路径: ${OHOS_NDK_ROOT}" && \
    ls -la ${OHOS_NDK_ROOT}/ || echo "NDK根目录不存在" && \
    ls -la ${OHOS_NDK_ROOT}/llvm/bin/ | head -5 || echo "llvm/bin目录不存在" && \
    ${OHOS_NDK_ROOT}/llvm/bin/clang --version || echo "clang不可用" && \
    echo "OpenHarmony SDK 验证完成"

# 设置工作目录
WORKDIR /workspace

# 默认命令
CMD ["/bin/bash"]
