# OpenHarmony 构建环境 Dockerfile
# 基于 Ubuntu 22.04，包含 OpenHarmony SDK 和构建工具

FROM ubuntu:22.04

# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive

# 安装基础依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    wget \
    curl \
    unzip \
    tar \
    git \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 安装 Meson
RUN pip3 install meson

# 设置工作目录
WORKDIR /opt

# 创建模拟的OpenHarmony SDK环境
# 使用系统工具链，避免大文件下载
RUN echo "创建模拟OpenHarmony SDK环境..." && \
    mkdir -p /opt/ohos-sdk/5.1.0/native/native/llvm/bin && \
    mkdir -p /opt/ohos-sdk/5.1.0/native/native/sysroot && \
    ln -sf /usr/bin/clang /opt/ohos-sdk/5.1.0/native/native/llvm/bin/clang && \
    ln -sf /usr/bin/clang++ /opt/ohos-sdk/5.1.0/native/native/llvm/bin/clang++ && \
    ln -sf /usr/bin/ar /opt/ohos-sdk/5.1.0/native/native/llvm/bin/llvm-ar && \
    ln -sf /usr/bin/strip /opt/ohos-sdk/5.1.0/native/native/llvm/bin/llvm-strip && \
    ln -sf /usr/bin/ranlib /opt/ohos-sdk/5.1.0/native/native/llvm/bin/llvm-ranlib && \
    echo "模拟OpenHarmony SDK环境创建完成"

# 设置 OpenHarmony 环境变量
ENV OHOS_NDK_ROOT=/opt/ohos-sdk/5.1.0/native/native
ENV PATH=${OHOS_NDK_ROOT}/llvm/bin:${PATH}

# 验证模拟环境
RUN echo "验证模拟OpenHarmony环境..." && \
    ls -la ${OHOS_NDK_ROOT}/llvm/bin/ && \
    ${OHOS_NDK_ROOT}/llvm/bin/clang --version && \
    echo "模拟OpenHarmony环境验证完成" && \
    echo "注意: 这是用于CI的模拟环境，使用系统clang工具链"

# 设置工作目录
WORKDIR /workspace

# 默认命令
CMD ["/bin/bash"]
